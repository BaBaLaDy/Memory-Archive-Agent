# Memory Archive Agent (MAA) 环境变量配置
# 复制此文件为 .env 并填入真实值
# 敏感字段（API Key、Token 等）统一在此管理，不会写入 config.json

# ---------- LLM ----------
# DashScope API Key（必填）
# 获取地址: https://dashscope.aliyuncs.com/
DASHSCOPE_API_KEY=your-api-key-here

# LLM 模型名（可选，默认 qwen3.6-plus）
# MAA_LLM_MODEL=qwen3.6-plus

# API Base URL（可选）
# MAA_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 工具 ----------
# Firecrawl 网页抓取 API Key（可选）
# 获取地址: https://www.firecrawl.com/
MAA_FIRECRAWL_API_KEY=your-firecrawl-key-here

# ---------- 通道 ----------
# Telegram Bot Token（可选）
MAA_TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Feishu 应用凭证（可选）
MAA_FEISHU_APP_ID=your-feishu-app-id-here
MAA_FEISHU_APP_SECRET=your-feishu-app-secret-here

# ---------- 存储 ----------
# 存储根目录（可选，默认 ~/MemoryArchive）
# MAA_STORAGE_ROOT=~/MemoryArchive
